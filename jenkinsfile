
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Build Started'
                echo 'Hello from Jenkins Pipeline'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing Completed'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment Completed'
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}

